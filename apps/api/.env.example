DATABASE_URL="postgresql://soma:soma_dev@localhost:5432/soma?schema=public"
PORT=3000

# Allowed browser origin for CORS (single origin string).
# Also used by AuthOriginGuard for cookie-authenticated /auth/refresh and /auth/logout.
CORS_ORIGIN=http://localhost:5173

# Required. Use a long random string in every environment. Never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret

# Registration access. Production MUST set this explicitly to open or invite
# (the API refuses to boot otherwise). Non-production defaults to open when unset.
# Beta uses invite: POST /auth/register requires a one-time hashed invite token.
# AUTH_REGISTRATION_MODE=open
# AUTH_REGISTRATION_MODE=invite
# Invite lifetime in days when minting (default 14, max 365):
# AUTH_INVITE_EXPIRES_DAYS=14
# Operator mint (plaintext printed once to stdout, never stored):
#   pnpm --filter @soma/api invite:mint

# Access-token lifetime. Delivery 3 SPA auto-refresh expects 15m.
# Do not leave a longer override in apps/api/.env accidentally.
JWT_EXPIRES_IN=15m

# Refresh session lifetime (days). Stored as hash in RefreshToken; cookie maxAge matches.
# AUTH_REFRESH_EXPIRES_DAYS=14

# Twin-tab concurrent loser window (ms). Within this window a second refresh
# with the old token fails closed (401) without revoking the winner's family.
# Outside it, reuse revokes the whole family. Never mints from a rotated token.
# AUTH_REFRESH_CONCURRENT_RACE_MS=2000

# Cookie flags for soma_refresh (HttpOnly, path=/auth).
# AUTH_COOKIE_SECURE=true|false  (default: true when NODE_ENV=production)
# AUTH_COOKIE_SAMESITE=lax|strict|none
# AUTH_COOKIE_CROSS_SITE=true    (production hint to use SameSite=None when Secure)

# Public SPA origin used ONLY to build password-reset links.
# Never derived from Host/Origin/Referer. Must be HTTPS in production.
APP_PUBLIC_URL=http://localhost:5173

# Password-reset token lifetime (minutes, default 30).
# AUTH_PASSWORD_RESET_EXPIRES_MINUTES=30

# Password-reset mailer.
# memory   = in-process capture (default outside production; FORBIDDEN in production)
# log      = redacted log; full URL only with AUTH_PASSWORD_RESET_DEV_LOG=true outside production
#            (FORBIDDEN in production)
# disabled = explicit no-send; safe in production; forgot-password does not mint/invalidate tokens
# resend   = Resend HTTP API (requires RESEND_API_KEY + PASSWORD_RESET_FROM_EMAIL).
#            If either credential is missing, falls back to disabled (no invented secrets).
# Production bootstrap rejects memory/log/none/unset — use disabled or a configured provider.
# AUTH_PASSWORD_RESET_MAILER=memory
# AUTH_PASSWORD_RESET_DEV_LOG=true
#
# Real provider (leave unset until authorized; never commit real secrets):
# AUTH_PASSWORD_RESET_MAILER=resend
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=Soma <noreply@your-verified-domain>
# Optional Resend HTTP timeout in ms (default 15000):
# RESEND_SEND_TIMEOUT_MS=15000

# Optional floor for forgot-password response time (ms) to reduce trivial timing leaks.
# AUTH_PASSWORD_RESET_MIN_MS=200

# Optional overrides for auth rate limits (milliseconds / attempt counts).
# Defaults: login 5 / 15min, register 3 / 1h, refresh 30 / 1min,
# forgot-password 3 / 1h, reset-password 5 / 1h.
# AUTH_LOGIN_THROTTLE_LIMIT=5
# AUTH_LOGIN_THROTTLE_TTL_MS=900000
# AUTH_REGISTER_THROTTLE_LIMIT=3
# AUTH_REGISTER_THROTTLE_TTL_MS=3600000
# AUTH_REFRESH_THROTTLE_LIMIT=30
# AUTH_REFRESH_THROTTLE_TTL_MS=60000
# AUTH_FORGOT_PASSWORD_THROTTLE_LIMIT=3
# AUTH_FORGOT_PASSWORD_THROTTLE_TTL_MS=3600000
# AUTH_RESET_PASSWORD_THROTTLE_LIMIT=5
# AUTH_RESET_PASSWORD_THROTTLE_TTL_MS=3600000
