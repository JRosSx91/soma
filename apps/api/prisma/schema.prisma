generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum BiologicalSex {
  male
  female
}

enum SubstanceCategory {
  depressant
  stimulant
  cannabinoid
  nicotine
  opioid
  hallucinogen
  dissociative
}

enum UsageFrequency {
  daily
  weekly
  monthly
  occasional
}

enum BodySystem {
  respiratory
  cardiovascular
  hepatic
  renal
  nervous_central
  nervous_peripheral
  endocrine
  reproductive
  digestive
  immune
  integumentary
  sensory
}

enum RecoveryCurveShape {
  logarithmic
  sigmoidal
  linear
  stepwise
}

enum ConfidenceLevel {
  high
  medium
  low
}

enum Neurotransmitter {
  dopamine
  serotonin
  gaba
  glutamate
  acetylcholine
  norepinephrine
  endocannabinoid
  endorphin
  adenosine
}

enum WithdrawalPhase {
  during_use
  acute_withdrawal
  post_acute
  normalizing
}

enum NeurotransmitterDirection {
  depleted
  elevated
  oscillating
  normalizing
}

enum NeurotransmitterSeverity {
  severe
  moderate
  mild
  normalizing
}

enum AchievementTier {
  bronze
  silver
  gold
  platinum
}

enum AchievementFamily {
  curve
  temporal
}

enum UsageStatus {
  abstinent
  active
}

/// Explicit onboarding intent. Independent of SubstanceUsage row count.
enum OnboardingStatus {
  pending
  skipped
  completed
}

// -----------------------------------------------------------------------------
// User domain
// -----------------------------------------------------------------------------

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  hashedPassword   String
  displayName      String
  biologicalSex    BiologicalSex
  birthYear        Int
  weightKg         Float?
  /// pending until the user skips or completes substance setup.
  onboardingStatus OnboardingStatus @default(pending)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  usages              SubstanceUsage[]
  achievements        UserAchievement[]
  journalEntries      JournalEntry[]
  journalMilestones   JournalPersonalMilestone[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  registrationInvite  RegistrationInvite?

  @@index([email])
}

/// One-time closed-beta registration invites. Plaintext is shown once to an
/// operator; only tokenHash is stored. usedByUserId is set after User insert.
model RegistrationInvite {
  id           String    @id
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?   @unique
  revokedAt    DateTime?

  usedBy User? @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([usedAt])
}

/// One-time password-reset tokens. Plaintext is emailed; only tokenHash is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hex digest of the opaque reset token.
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Set when the token is successfully consumed (or invalidated).
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, usedAt])
}

/// Opaque refresh sessions. The plaintext token is never stored — only tokenHash.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// SHA-256 hex digest of the opaque refresh token.
  tokenHash    String    @unique
  /// Groups rotated tokens that belong to one login session.
  familyId     String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Next token in a successful rotation chain (null until rotated).
  replacedById String?
  /// Truncated User-Agent (optional, diagnostic only).
  userAgent    String?
  /// SHA-256 of the client IP (optional). Raw IPs are not stored.
  ipHash       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Substance catalog
// -----------------------------------------------------------------------------

model Substance {
  id                       String            @id
  name                     String
  category                 SubstanceCategory
  shortDescription         String

  usages                   SubstanceUsage[]
  damageProfiles           OrganDamageProfile[]
  recoveryCurves           OrganRecoveryCurve[]
  achievements             Achievement[]
  neurotransmitterProfiles NeurotransmitterProfile[]
  narrativeProfiles        OrganNarrativeProfile[]
  journalCravings          JournalEntry[]
}

model SubstanceUsage {
  id           String         @id @default(cuid())
  userId       String
  substanceId  String
  yearStarted  Int
  frequency    UsageFrequency
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastUseDate  DateTime?
  status       UsageStatus    @default(abstinent)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  substance    Substance      @relation(fields: [substanceId], references: [id])

  @@index([userId])
  @@index([substanceId])
}

// -----------------------------------------------------------------------------
// Physiological model
// -----------------------------------------------------------------------------

model Organ {
  id                 String     @id
  name               String
  system             BodySystem
  shortDescription   String

  damageProfiles     OrganDamageProfile[]
  recoveryCurves     OrganRecoveryCurve[]
  achievements       Achievement[]
  narrativeProfiles  OrganNarrativeProfile[]
}

model OrganDamageProfile {
  id              String          @id @default(cuid())
  organId         String
  substanceId     String
  maxSeverity     Float
  confidenceLevel ConfidenceLevel
  referenceSource String

  organ           Organ           @relation(fields: [organId], references: [id])
  substance       Substance       @relation(fields: [substanceId], references: [id])

  @@unique([organId, substanceId])
  @@index([substanceId])
}

model OrganRecoveryCurve {
  id               String             @id @default(cuid())
  organId          String
  substanceId      String
  shape            RecoveryCurveShape
  daysTo95Recovery Int
  recoveryCeiling  Float
  confidenceLevel  ConfidenceLevel
  referenceSource  String

  organ            Organ              @relation(fields: [organId], references: [id])
  substance        Substance          @relation(fields: [substanceId], references: [id])

  @@unique([organId, substanceId])
  @@index([substanceId])
}

// -----------------------------------------------------------------------------
// Achievements
// -----------------------------------------------------------------------------

model Achievement {
  id                        String             @id
  family                    AchievementFamily  @default(curve)
  tier                      AchievementTier

  // i18n keys under the `achievements` namespace.
  // Format: <achievement-id>.title and <achievement-id>.description
  // Example key path: achievements.alcohol-liver-bronze.title
  titleKey                  String
  descriptionKey            String

  triggerOrganId            String?
  triggerSubstanceId        String
  triggerRecoveryThreshold  Float?
  triggerAbstinenceDays     Int?

  triggerOrgan              Organ?             @relation(fields: [triggerOrganId], references: [id])
  triggerSubstance          Substance          @relation(fields: [triggerSubstanceId], references: [id])
  unlockedBy                UserAchievement[]

  hidden Boolean @default(false)

  @@index([triggerSubstanceId])
  @@index([triggerOrganId])
  @@index([family])
}

// -----------------------------------------------------------------------------
// Neurotransmitter model
// -----------------------------------------------------------------------------

model NeurotransmitterProfile {
  id               String                  @id @default(cuid())
  substanceId      String
  neurotransmitter Neurotransmitter
  confidenceLevel  ConfidenceLevel
  referenceSource  String
  mechanismKey     String?
  substance        Substance               @relation(fields: [substanceId], references: [id])
  phases           NeurotransmitterPhase[]

  @@unique([substanceId, neurotransmitter])
  @@index([substanceId])
}

model NeurotransmitterPhase {
  id          String                    @id @default(cuid())
  profileId   String
  phase       WithdrawalPhase

  // Inclusive day boundaries from last-use date.
  // endDay is null for the final phase (normalizing continues
  // open-endedly until baseline is approximated).
  startDay    Int
  endDay      Int?

  severity    NeurotransmitterSeverity
  direction   NeurotransmitterDirection

  // i18n key under the `neurotransmitter-phases` namespace.
  // Format: <substanceId>.<neurotransmitter>.<phase>
  // Example: cocaine.dopamine.acute_withdrawal
  symptomKey  String

  profile     NeurotransmitterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// -----------------------------------------------------------------------------
// Organ narrative model
// -----------------------------------------------------------------------------
//
// Describes the cellular/tissue-level recovery process for non-neural
// organs. Unlike neurotransmitters, these narratives focus on observable
// physiological processes (cilia movement, tissue regeneration, mucosa
// healing) rather than subjective experience.
//
// Reuses the WithdrawalPhase enum from the neurotransmitter model.

model OrganNarrativeProfile {
  id              String                 @id @default(cuid())
  organId         String
  substanceId     String
  confidenceLevel ConfidenceLevel
  referenceSource String

  organ           Organ                  @relation(fields: [organId], references: [id])
  substance       Substance              @relation(fields: [substanceId], references: [id])
  phases          OrganNarrativePhase[]

  @@unique([organId, substanceId])
  @@index([organId])
  @@index([substanceId])
}

model OrganNarrativePhase {
  id          String                  @id @default(cuid())
  profileId   String
  phase       WithdrawalPhase

  // Inclusive day boundaries from last-use date.
  // endDay is null for the final (normalizing) phase.
  startDay    Int
  endDay      Int?

  // i18n key under the `organ-narrative` namespace.
  // Format: <organId>.<substanceId>.<phase>
  // Example: lungs.nicotine.acute_withdrawal
  narrativeKey String

  profile     OrganNarrativeProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// -----------------------------------------------------------------------------
// User achievements
// -----------------------------------------------------------------------------
//
// Persisted record of which achievements a user has unlocked, when, and
// whether they have been notified about it. Calculated on-demand when
// the user queries /me/achievements; new unlocks are inserted, existing
// rows are not modified.
//
// `unlockedAt` reflects the actual date the recovery threshold was
// crossed (computed by inverting the recovery curve from the user's
// lastUseDate), not the time of detection.
//
// `notifiedAt` is null until the frontend (web) or push system (mobile)
// surfaces the achievement to the user via trophy toasts (POST mark-notified).
// Historical toast-ack only. Not inbox-read and not celebration-claim.
//
// `createdAt` is when Soma inserted the unlock (API: detectedAt).
// `inboxReadAt` is when the in-app notification center marked it read.
// `celebratedAt` is when a celebration presentation was *claimed*
// (atomic lock before show). It is not proof the modal finished.

// -----------------------------------------------------------------------------
// Personal journal (JRN-01)
// -----------------------------------------------------------------------------
//
// `occurredOn` is a civil calendar date (`DATE` / `@db.Date`), not a UTC
// instant. The public contract is `YYYY-MM-DD`. Map at the API boundary with
// `civilDateToUtcDate` / `utcDateToCivilDate` in `@soma/shared-types` so a
// local timezone never shifts the stored day. `createdAt` / `updatedAt` are
// real timestamps. Several rows may share the same (`userId`, `occurredOn`).
// Catalog IDs for emotions/triggers live in shared-types, not extra tables.
// Optional `cravingSubstanceId` points at the Substance catalog; it never
// writes SubstanceUsage or abstinence clocks.

model JournalEntry {
  id                 String    @id @default(cuid())
  userId             String
  /// Civil date the user associates with the entry (`YYYY-MM-DD` at the API).
  occurredOn         DateTime  @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mood               Int?
  sleep              Int?
  energy             Int?
  anxiety            Int?
  cravingIntensity   Int?
  cravingSubstanceId String?
  /// Voluntary 0–10 self-rating. Null on historical rows; never backfilled.
  wellbeingRating    Int?
  title              String?
  body               String?   @db.Text
  highlighted        Boolean   @default(false)
  learning           Boolean   @default(false)
  emotionIds         String[]  @default([])
  triggerIds         String[]  @default([])

  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cravingSubstance   Substance? @relation(fields: [cravingSubstanceId], references: [id], onDelete: SetNull)

  @@index([userId, occurredOn])
  @@index([userId, createdAt])
  @@index([userId, highlighted])
}

/// Perceived everyday improvements recorded by the person. Not medals.
model JournalPersonalMilestone {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  occurredOn DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredOn])
}

model UserAchievement {
  id              String      @id @default(cuid())
  userId          String
  achievementId   String

  // The actual date the user crossed the recovery threshold.
  unlockedAt      DateTime

  // Null until the user has been notified of this unlock.
  // Set by frontend (web batch toast) or push notification system.
  notifiedAt      DateTime?

  createdAt       DateTime    @default(now())

  inboxReadAt     DateTime?
  celebratedAt    DateTime?

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement     Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([userId, notifiedAt])
}