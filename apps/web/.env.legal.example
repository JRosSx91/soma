# Legal controller identity for public notices (GDPR Art. 13 / LSSI).
# Copy these keys into apps/web/.env.local or the hosting build environment.
# Do not commit real values. Do not put personal data in git.
#
# Required before LEGAL_NOTICE_STATUS can be treated as published:
VITE_LEGAL_CONTROLLER_NAME=
VITE_LEGAL_CONTROLLER_EMAIL=
#
# Optional — omitted from the documents when empty.
# Do not invent a postal address. Leave ADDRESS empty to omit it.
VITE_LEGAL_CONTROLLER_ADDRESS=
VITE_LEGAL_CONTROLLER_TAX_ID=
VITE_LEGAL_CONTROLLER_PHONE=
VITE_LEGAL_CONTROLLER_DPO=
