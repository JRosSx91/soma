# API base URL for the SPA fetch client.
#
# Leave empty (or omit) in local HTTP so requests stay same-origin and
# Vite proxies /auth, /me, /health, /substances to the Nest API. This is
# required for SameSite=Lax HttpOnly refresh cookies without HTTPS.
#
# Open the SPA at the same host as CORS_ORIGIN (default http://localhost:5173).
# http://127.0.0.1:5173 is a different Origin and AuthOriginGuard will reject
# /auth/refresh and /auth/logout.
#
# For a cross-origin API (separate host), set the absolute origin and
# configure the API with AUTH_COOKIE_SAMESITE=none + AUTH_COOKIE_SECURE=true.
# VITE_API_URL=

# Legal controller identity (no real personal data in this file).
# See .env.legal.example. Copy keys into .env.local or the hosting build env.
# VITE_LEGAL_CONTROLLER_NAME=
# VITE_LEGAL_CONTROLLER_EMAIL=
# VITE_LEGAL_CONTROLLER_ADDRESS=
# VITE_LEGAL_CONTROLLER_TAX_ID=
# VITE_LEGAL_CONTROLLER_PHONE=
# VITE_LEGAL_CONTROLLER_DPO=
